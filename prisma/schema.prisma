// Joba's Closet — orders are persisted so they can be confirmed, tracked
// and (in future) managed from an admin system. No admin panel yet by design.
// Accounts are optional: orders may belong to a registered User or a guest.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  orders       Order[]
}

model Session {
  id        String   @id // opaque random token, stored in an httpOnly cookie
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Order {
  id           String      @id // e.g. JC-4F7K2M
  userId       String?
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName String
  phone        String
  email        String?
  address      String
  city         String
  note         String?
  zone         String // "inside" | "outside"
  payment      String      @default("cod")
  status       String      @default("confirmed")
  subtotal     Float
  delivery     Float
  total        Float
  createdAt    DateTime    @default(now())
  items        OrderItem[]

  @@index([userId])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  name      String
  price     Float
  qty       Int
  image     String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}
